# Operator environment for setup, build and deploy.
# Copy to .env (git-ignored), fill in, then load into your shell:
#   set -a; source .env; set +a
# Nothing reads .env automatically. Never put secret values here except where
# noted; OAuth client secrets go in through the hidden-input CLI (docs/authentication.md).

# --- GCP project (docs/setup-gcp.md) ---
GCP_PROJECT_ID=your-project-id
GCP_REGION=europe-west3

# --- Build (scripts/build.sh) ---
# docker = local buildx, cloudbuild = remote Cloud Build
BUILDER=cloudbuild
# Tag used by scripts/build-local-offline.sh
LOCAL_IMAGE=g-utils-mcp:local

# --- Optional remote Terraform state (docs/terraform.md) ---
# terraform -chdir=infrastructure/bootstrap output -raw state_bucket
TF_STATE_BUCKET=

# --- Policy/runtime settings, used by scripts/gcs_policy.py, doctor.py ---
# Values come from foundation outputs after `terraform apply`:
#   terraform -chdir=infrastructure/foundation output -raw policy_uri
#   terraform -chdir=infrastructure/foundation output -raw temporary_bucket
GOOGLE_CLOUD_PROJECT=your-project-id
POLICY_URI=gs://your-project-id-g-utils-mcp-policy/policies/g-utils-mcp.yml
TEMP_BUCKET=your-project-id-g-utils-mcp-temporary
# JSON array
ALLOWED_SECRET_PROJECTS=["your-project-id"]

# --- Deploy (scripts/configure_service.py, scripts/deploy.sh) ---
# Last line printed by scripts/build.sh
IMAGE_DIGEST=europe-west3-docker.pkg.dev/your-project-id/g-utils-mcp/server@sha256:REPLACE_WITH_64_HEX
# Empty on first deploy; then:
#   terraform -chdir=infrastructure/service output -raw service_url
PUBLIC_BASE_URL=

# --- Client / smoke test (scripts/smoke.py, docs/claude-cloud.md) ---
# HTTPS origin of the deployed service (same as PUBLIC_BASE_URL)
MCP_URL=
# SECRET: agent bearer token. Prefer a secret store; if set here, keep .env private.
MCP_TOKEN=

# --- Optional runtime tuning (set on Cloud Run via Terraform, not needed locally) ---
# PORT=8080
# MAX_TRANSFER_BYTES=20000000
# MAX_RESULT_BYTES=1000000
# ARTIFACT_TTL_SECONDS=1800
