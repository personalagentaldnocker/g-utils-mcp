# Operator settings. Copy to .env (git-ignored), fill in, then load into your shell:
#   set -a; source .env; set +a
# No secret values belong here except MCP_TOKEN, and only if you keep .env private.

GCP_PROJECT_ID=your-project-id
GCP_REGION=europe-west3

# cloudbuild (default) or docker
BUILDER=cloudbuild

# From `terraform -chdir=infrastructure/foundation output` (these are the defaults):
POLICY_URI=gs://${GCP_PROJECT_ID}-g-utils-mcp-policy/policies/g-utils-mcp.yml
SECRET_NAME=projects/${GCP_PROJECT_ID}/secrets/g-utils-mcp

# For the agent (.mcp.json) and scripts/smoke.py:
# MCP_URL is printed by scripts/deploy.sh; MCP_TOKEN is the content of local/mcp-token.
MCP_URL=
MCP_TOKEN=
